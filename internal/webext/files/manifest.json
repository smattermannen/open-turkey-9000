{
  "manifest_version": 2,
  "name": "Killer Chicken 9000",
  "version": "1.14.0",
  "description": "Enforces Killer Chicken 9000 blocks inside the browser.",
  "browser_specific_settings": {
    "gecko": { "id": "blocker@kc9k" }
  },
  "incognito": "spanning",
  "permissions": ["webRequest", "webRequestBlocking", "storage", "tabs", "idle", "<all_urls>", "http://127.0.0.1/*"],
  "browser_action": {
    "default_title": "Killer Chicken 9000",
    "default_popup": "popup.html",
    "default_icon": "icon.svg",
    "default_area": "navbar"
  },
  "icons": { "48": "icon.svg", "96": "icon.svg" },
  "background": { "scripts": ["match.js", "social.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["match.js", "social.js", "content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": ["blocked.html"]
}
